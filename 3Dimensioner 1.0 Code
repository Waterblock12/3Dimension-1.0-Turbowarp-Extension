/* =====================================================
   WEBGL INITIALIZATION
===================================================== */

function compileShader(gl, type, source) {
    const shader = gl.createShader(type);
    gl.shaderSource(shader, source);
    gl.compileShader(shader);

    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
        const message = gl.getShaderInfoLog(shader);
        gl.deleteShader(shader);
        throw new Error("Shader greška: " + message);
    }

    return shader;
}

function createProgram(gl) {
    const vs = compileShader(gl, gl.VERTEX_SHADER, VERTEX_SHADER);
    const fs = compileShader(gl, gl.FRAGMENT_SHADER, FRAGMENT_SHADER);

    const program = gl.createProgram();
    gl.attachShader(program, vs);
    gl.attachShader(program, fs);
    gl.linkProgram(program);

    gl.deleteShader(vs);
    gl.deleteShader(fs);

    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
        throw new Error("WebGL program greška: " + gl.getProgramInfoLog(program));
    }

    return program;
}

function findStageCanvas() {
    try {
        if (Scratch.vm && Scratch.vm.renderer && Scratch.vm.renderer.canvas) {
            return Scratch.vm.renderer.canvas;
        }

        if (Scratch.vm && Scratch.vm.runtime &&
            Scratch.vm.runtime.renderer &&
            Scratch.vm.runtime.renderer.canvas) {
            return Scratch.vm.runtime.renderer.canvas;
        }
    } catch (e) {}

    return document.querySelector("canvas");
}

function setupRenderer() {
    if (state.gl && state.canvas) return true;

    const stage = findStageCanvas();
    if (!stage || !stage.parentElement) return false;

    state.stage = stage;

    const overlay = document.createElement("canvas");
    overlay.id = "threedimensioner-overlay";

    Object.assign(overlay.style, {
        position: "absolute",
        left: "0",
        top: "0",
        width: "100%",
        height: "100%",
        pointerEvents: "none",
        zIndex: "5"
    });

    const parent = stage.parentElement;

    if (getComputedStyle(parent).position === "static") {
        parent.style.position = "relative";
    }

    parent.appendChild(overlay);

    const gl = overlay.getContext("webgl", {
        alpha: true,
        antialias: true,
        depth: true,
        premultipliedAlpha: false
    }) || overlay.getContext("experimental-webgl", {
        alpha: true,
        antialias: true,
        depth: true
    });

    if (!gl) {
        overlay.remove();
        throw new Error("WebGL nije dostupan u ovom browseru.");
    }

    state.overlay = overlay;
    state.canvas = overlay;
    state.gl = gl;

    state.program = createProgram(gl);

    state.locations = {
        position: gl.getAttribLocation(state.program, "aPosition"),
        normal: gl.getAttribLocation(state.program, "aNormal"),
        uv: gl.getAttribLocation(state.program, "aUV"),
        color: gl.getAttribLocation(state.program, "aColor"),

        mvp: gl.getUniformLocation(state.program, "uMVP"),
        model: gl.getUniformLocation(state.program, "uModel"),
        materialColor: gl.getUniformLocation(state.program, "uMaterialColor"),
        alpha: gl.getUniformLocation(state.program, "uAlpha"),
        texture: gl.getUniformLocation(state.program, "uTexture"),
        useTexture: gl.getUniformLocation(state.program, "uUseTexture")
    };

    gl.enable(gl.DEPTH_TEST);
    gl.depthFunc(gl.LEQUAL);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);
    gl.disable(gl.CULL_FACE);

    for (const model of state.models) {
        uploadModel(model);
    }

    resizeRenderer();
    setStatus("3D renderer spreman");

    return true;
}

function resizeRenderer() {
    if (!state.canvas || !state.stage) return;

    const rect = state.stage.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    const width = Math.max(1, Math.round(rect.width * dpr));
    const height = Math.max(1, Math.round(rect.height * dpr));

    if (state.canvas.width !== width || state.canvas.height !== height) {
        state.canvas.width = width;
        state.canvas.height = height;
    }

    state.canvas.style.left = state.stage.offsetLeft + "px";
    state.canvas.style.top = state.stage.offsetTop + "px";
    state.canvas.style.width = rect.width + "px";
    state.canvas.style.height = rect.height + "px";

    state.gl.viewport(0, 0, width, height);
}

/* =====================================================
   GPU MODEL UPLOAD
===================================================== */

function createBuffer(gl, data) {
    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);
    return buffer;
}

function uploadModel(model) {
    const gl = state.gl;
    if (!gl) return;

    model.gpu = [];

    for (const group of model.meshGroups) {
        const gpu = {
            position: createBuffer(gl, group.positions),
            normal: createBuffer(gl, group.normals),
            uv: createBuffer(gl, group.uv),
            color: createBuffer(gl, group.colors),
            count: group.vertexCount,
            texture: null
        };

        if (group.textureImage) {
            const texture = gl.createTexture();

            gl.bindTexture(gl.TEXTURE_2D, texture);
            gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
            gl.texImage2D(
                gl.TEXTURE_2D,
                0,
                gl.RGBA,
                gl.RGBA,
                gl.UNSIGNED_BYTE,
                group.textureImage
            );

            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);

            gpu.texture = texture;
        }

        model.gpu.push(gpu);
    }
}

/* =====================================================
   MODEL MATRIX
===================================================== */

function getModelMatrix(model) {
    let matrix = mat4Identity();

    matrix = mat4Multiply(matrix, mat4Translation(
        model.x, model.y, model.z
    ));

    matrix = mat4Multiply(matrix, mat4RotationZ(rad(model.rz)));
    matrix = mat4Multiply(matrix, mat4RotationY(rad(model.ry)));
    matrix = mat4Multiply(matrix, mat4RotationX(rad(model.rx)));

    return matrix;
}

/* =====================================================
   RENDERING
===================================================== */

function bindAttribute(gl, location, buffer, size) {
    if (location < 0) return;

    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    gl.enableVertexAttribArray(location);
    gl.vertexAttribPointer(location, size, gl.FLOAT, false, 0, 0);
}

function renderFrame(timestamp) {
    if (!state.running) return;

    if (!state.gl) {
        try {
            setupRenderer();
        } catch (e) {
            setStatus(e.message);
        }
    }

    if (!state.gl) {
        requestAnimationFrame(renderFrame);
        return;
    }

    if (timestamp - state.lastFrame < state.frameInterval - 1) {
        requestAnimationFrame(renderFrame);
        return;
    }

    state.lastFrame = timestamp;

    resizeRenderer();

    const gl = state.gl;
    const width = state.canvas.width;
    const height = state.canvas.height;

    gl.clearColor(0, 0, 0, 0);
    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);

    gl.useProgram(state.program);

    const projection = mat4Perspective(
        rad(70),
        width / Math.max(1, height),
        0.01,
        1000
    );

    const view = mat4LookCamera(state.camera);

    for (const model of state.models) {
        if (!model.visible || !model.gpu.length) continue;

        const modelMatrix = getModelMatrix(model);
        const viewModel = mat4Multiply(view, modelMatrix);
        const mvp = mat4Multiply(projection, viewModel);

        gl.uniformMatrix4fv(state.locations.mvp, false, mvp);
        gl.uniformMatrix4fv(state.locations.model, false, modelMatrix);

        for (let i = 0; i < model.gpu.length; i++) {
            const gpu = model.gpu[i];
            const group = model.meshGroups[i];
            const material = group.material;

            bindAttribute(gl, state.locations.position, gpu.position, 3);
            bindAttribute(gl, state.locations.normal, gpu.normal, 3);
            bindAttribute(gl, state.locations.uv, gpu.uv, 2);
            bindAttribute(gl, state.locations.color, gpu.color, 3);

            gl.uniform3fv(
                state.locations.materialColor,
                new Float32Array(material.color || [0.8, 0.8, 0.8])
            );

            gl.uniform1f(state.locations.alpha, material.alpha ?? 1);

            if (gpu.texture) {
                gl.activeTexture(gl.TEXTURE0);
                gl.bindTexture(gl.TEXTURE_2D, gpu.texture);
                gl.uniform1i(state.locations.texture, 0);
                gl.uniform1f(state.locations.useTexture, 1);
            } else {
                gl.uniform1f(state.locations.useTexture, 0);
            }

            gl.drawArrays(gl.TRIANGLES, 0, gpu.count);
        }
    }

    requestAnimationFrame(renderFrame);
}

/* =====================================================
   EDITOR UI
===================================================== */

function createEditor() {
    if (state.editor) return;

    const root = document.createElement("div");
    root.id = "threedimensioner-editor";

    Object.assign(root.style, {
        position: "fixed",
        right: "16px",
        bottom: "16px",
        width: "300px",
        maxHeight: "65vh",
        overflowY: "auto",
        zIndex: "999999",
        background: "#202735",
        color: "#f4f6ff",
        border: "1px solid #516499",
        borderRadius: "12px",
        padding: "12px",
        fontFamily: "Arial, sans-serif",
        fontSize: "13px",
        boxShadow: "0 8px 30px rgba(0,0,0,.35)"
    });

    const title = document.createElement("div");
    title.textContent = "3Dimensioner 1.2";
    Object.assign(title.style, {
        fontWeight: "bold",
        fontSize: "16px",
        marginBottom: "10px"
    });

    const addButton = document.createElement("button");
    addButton.textContent = "+ Add Model (.ZIP)";
    styleButton(addButton);
    addButton.style.width = "100%";

    const listTitle = document.createElement("div");
    listTitle.textContent = "Models";
    listTitle.style.marginTop = "14px";
    listTitle.style.fontWeight = "bold";

    const list = document.createElement("div");
    list.style.marginTop = "6px";

    const status = document.createElement("div");
    status.textContent = "Spreman";
    Object.assign(status.style, {
        marginTop: "12px",
        color: "#b9c8ff",
        overflowWrap: "anywhere",
        fontSize: "12px"
    });

    const fileInput = document.createElement("input");
    fileInput.type = "file";
    fileInput.accept = ".zip,application/zip";
    fileInput.style.display = "none";

    addButton.addEventListener("click", () => fileInput.click());

    fileInput.addEventListener("change", async () => {
        const file = fileInput.files && fileInput.files[0];
        if (!file) return;

        try {
            await importZip(file);
        } catch (e) {
            console.error("[3Dimensioner]", e);
            setStatus("Greška: " + e.message);
        }

        fileInput.value = "";
    });

    const closeButton = document.createElement("button");
    closeButton.textContent = "Sakrij editor";
    styleButton(closeButton);
    closeButton.style.width = "100%";
    closeButton.style.marginTop = "10px";

    closeButton.addEventListener("click", () => {
        root.style.display = "none";
    });

    root.append(
        title,
        addButton,
        listTitle,
        list,
        status,
        closeButton,
        fileInput
    );

    document.body.appendChild(root);

    state.editor = root;
    state.modelList = list;
    state.statusElement = status;
    state.fileInput = fileInput;

    refreshModelList();
}

function styleButton(button) {
    Object.assign(button.style, {
        background: "#516499",
        color: "white",
        border: "0",
        borderRadius: "7px",
        padding: "9px",
        cursor: "pointer",
        fontWeight: "bold"
    });
}

function refreshModelList() {
    if (!state.modelList) return;

    state.modelList.innerHTML = "";

    if (!state.models.length) {
        const empty = document.createElement("div");
        empty.textContent = "Nema učitanih modela.";
        empty.style.color = "#aab3c7";
        state.modelList.appendChild(empty);
        return;
    }

    for (const model of state.models) {
        const row = document.createElement("div");

        Object.assign(row.style, {
            display: "flex",
            alignItems: "center",
            gap: "6px",
            padding: "7px 0",
            borderBottom: "1px solid #3b4559"
        });

        const name = document.createElement("span");
        name.textContent = model.name;
        name.style.flex = "1";
        name.style.overflowWrap = "anywhere";

        const visibility = document.createElement("button");
        visibility.textContent = model.visible ? "Hide" : "Show";
        styleButton(visibility);

        visibility.addEventListener("click", () => {
            model.visible = !model.visible;
            refreshModelList();
        });

        const remove = document.createElement("button");
        remove.textContent = "×";
        styleButton(remove);

        remove.addEventListener("click", () => {
            deleteModel(model.id);
        });

        row.append(name, visibility, remove);
        state.modelList.appendChild(row);
    }
}

function deleteModel(id) {
    const index = state.models.findIndex(m => m.id === id);
    if (index < 0) return;

    const model = state.models[index];

    if (state.gl) {
        for (const gpu of model.gpu) {
            state.gl.deleteBuffer(gpu.position);
            state.gl.deleteBuffer(gpu.normal);
            state.gl.deleteBuffer(gpu.uv);
            state.gl.deleteBuffer(gpu.color);

            if (gpu.texture) {
                state.gl.deleteTexture(gpu.texture);
            }
        }
    }

    state.models.splice(index, 1);
    refreshModelList();
}

/* =====================================================
   TURBOWARP EXTENSION
===================================================== */

class ThreeDimensioner {
    getInfo() {
        return {
            id: "threedimensioner",
            name: "3Dimensioner",
            color1: EXTENSION_COLOR,
            color2: "#435783",
            color3: "#344469",

            blocks: [
                {
                    opcode: "setFPS",
                    blockType: Scratch.BlockType.COMMAND,
                    text: "run code at fps of [FPS]",
                    arguments: {
                        FPS: {
                            type: Scratch.ArgumentType.STRING,
                            menu: "fpsMenu",
                            defaultValue: "60"
                        }
                    }
                },
                {
                    opcode: "hideModel",
                    blockType: Scratch.BlockType.COMMAND,
                    text: "hide model [MODEL]",
                    arguments: {
                        MODEL: {
                            type: Scratch.ArgumentType.STRING,
                            menu: "modelMenu"
                        }
                    }
                },
                {
                    opcode: "showModel",
                    blockType: Scratch.BlockType.COMMAND,
                    text: "show model [MODEL]",
                    arguments: {
                        MODEL: {
                            type: Scratch.ArgumentType.STRING,
                            menu: "modelMenu"
                        }
                    }
                },
                {
                    opcode: "setModelPos",
                    blockType: Scratch.BlockType.COMMAND,
                    text: "set model [MODEL] pos to x [X] y [Y] z [Z]",
                    arguments: {
                        MODEL: {
                            type: Scratch.ArgumentType.STRING,
                            menu: "modelMenu"
                        },
                        X: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 },
                        Y: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 },
                        Z: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 }
                    }
                },
                {
                    opcode: "setCameraPos",
                    blockType: Scratch.BlockType.COMMAND,
                    text: "set camera pos to x [X] y [Y] z [Z]",
                    arguments: {
                        X: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 },
                        Y: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 },
                        Z: { type: Scratch.ArgumentType.NUMBER, defaultValue: 6 }
                    }
                },
                {
                    opcode: "setModelDir",
                    blockType: Scratch.BlockType.COMMAND,
                    text: "set dir of model [MODEL] to x [X] y [Y] z [Z]",
                    arguments: {
                        MODEL: {
                            type: Scratch.ArgumentType.STRING,
                            menu: "modelMenu"
                        },
                        X: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 },
                        Y: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 },
                        Z: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 }
                    }
                },
                {
                    opcode: "setCameraDir",
                    blockType: Scratch.BlockType.COMMAND,
                    text: "set dir of camera to x [X] y [Y] z [Z]",
                    arguments: {
                        X: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 },
                        Y: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 },
                        Z: { type: Scratch.ArgumentType.NUMBER, defaultValue: 0 }
                    }
                },
                {
                    opcode: "getPos",
                    blockType: Scratch.BlockType.REPORTER,
                    text: "pos of [OBJECT] [AXIS]",
                    arguments: {
                        OBJECT: {
                            type: Scratch.ArgumentType.STRING,
                            menu: "objectMenu"
                        },
                        AXIS: {
                            type: Scratch.ArgumentType.STRING,
                            menu: "axisMenu"
                        }
                    }
                },
                {
                    opcode: "getDir",
                    blockType: Scratch.BlockType.REPORTER,
                    text: "dir of [OBJECT] [AXIS]",
                    arguments: {
                        OBJECT: {
                            type: Scratch.ArgumentType.STRING,
                            menu: "objectMenu"
                        },
                        AXIS: {
                            type: Scratch.ArgumentType.STRING,
                            menu: "axisMenu"
                        }
                    }
                },
                {
                    opcode: "deleteObject",
                    blockType: Scratch.BlockType.COMMAND,
                    text: "delete [OBJECT]",
                    arguments: {
                        OBJECT: {
                            type: Scratch.ArgumentType.STRING,
                            menu: "objectMenu"
                        }
                    }
                }
            ],

            menus: {
                fpsMenu: {
                    acceptReporters: false,
                    items: ["30", "60", "120", "200", "250"]
                },
                modelMenu: {
                    acceptReporters: false,
                    items: "getModelMenu"
                },
                objectMenu: {
                    acceptReporters: false,
                    items: "getObjectMenu"
                },
                axisMenu: {
                    acceptReporters: false,
                    items: ["x", "y", "z"]
                }
            }
        };
    }

    getModelMenu() {
        return state.models.length
            ? state.models.map(m => m.name)
            : ["No models"];
    }

    getObjectMenu() {
        return ["camera", ...state.models.map(m => m.name)];
    }

    findModel(name) {
        return state.models.find(m => m.name === String(name));
    }

    setFPS(args) {
        const fps = Number(args.FPS);

        if ([30, 60, 120, 200, 250].includes(fps)) {
            state.fps = fps;
            state.frameInterval = 1000 / fps;
        }
    }

    hideModel(args) {
        const model = this.findModel(args.MODEL);
        if (model) {
            model.visible = false;
            refreshModelList();
        }
    }

    showModel(args) {
        const model = this.findModel(args.MODEL);
        if (model) {
            model.visible = true;
            refreshModelList();
        }
    }

    setModelPos(args) {
        const model = this.findModel(args.MODEL);
        if (!model) return;

        model.x = num(args.X);
        model.y = num(args.Y);
        model.z = num(args.Z);
    }

    setCameraPos(args) {
        state.camera.x = num(args.X);
        state.camera.y = num(args.Y);
        state.camera.z = num(args.Z);
    }

    setModelDir(args) {
        const model = this.findModel(args.MODEL);
        if (!model) return;

        model.rx = num(args.X);
        model.ry = num(args.Y);
        model.rz = num(args.Z);
    }

    setCameraDir(args) {
        state.camera.rx = num(args.X);
        state.camera.ry = num(args.Y);
        state.camera.rz = num(args.Z);
    }

    getPos(args) {
        const axis = String(args.AXIS || "x").toLowerCase();

        if (args.OBJECT === "camera") {
            return num(state.camera[axis]);
        }

        const model = this.findModel(args.OBJECT);
        return model ? num(model[axis]) : 0;
    }

    getDir(args) {
        const axis = String(args.AXIS || "x").toLowerCase();

        if (args.OBJECT === "camera") {
            return num(state.camera["r" + axis]);
        }

        const model = this.findModel(args.OBJECT);
        return model ? num(model["r" + axis]) : 0;
    }

    deleteObject(args) {
        if (args.OBJECT === "camera") return;

        const model = this.findModel(args.OBJECT);
        if (model) deleteModel(model.id);
    }
}

/* =====================================================
   STARTUP
===================================================== */

createEditor();

try {
    setupRenderer();
} catch (e) {
    setStatus("Renderer: " + e.message);
    console.error("[3Dimensioner]", e);
}

requestAnimationFrame(renderFrame);

window.addEventListener("resize", resizeRenderer);

Scratch.extensions.register(new ThreeDimensioner());

})(Scratch);
