const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
const num = v => Number.isFinite(Number(v)) ? Number(v) : 0;
const rad = v => num(v) * Math.PI / 180;

function setStatus(message) {
    state.status = String(message);
    if (state.statusElement) {
